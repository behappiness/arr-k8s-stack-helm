{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "abandonments:recommended"
  ],
  "description": [
    "schedule unset on purpose: the workflow cron decides when Renovate runs.",
    "assignees only fires on PRs Renovate will not automerge (assignAutomerge defaults to false), so routine bumps stay silent.",
    "platformAutomerge off: GitHub auto-merge needs branch protection, which this repo does not have. Renovate merges instead."
  ],
  "timezone": "Europe/Budapest",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "assignees": [
    "behappiness"
  ],
  "platformAutomerge": false,
  "labels": [
    "dependencies"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/charts/.+/values\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Sidecar images under vpn.*/metrics.*. Indented 4+ so the top-level image block stays with the helm-values manager.",
      "customType": "regex",
      "managerFilePatterns": [
        "/charts/.+/values\\.yaml$/"
      ],
      "matchStrings": [
        "\n\\s{4,}repository:\\s*(?<depName>[^\\s#]+)\\s*\n(?:\\s*#.*\n)*\\s*tag:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "appVersion holds the exact image tag, so Renovate updates it in the same PR as image.tag and the two cannot drift.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^charts/[^/]+/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+appVersion: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "CI workflow pins, each marked with a renovate: comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Name the commit after the image.",
      "matchManagers": [
        "helm-values",
        "custom.regex"
      ],
      "commitMessageTopic": "{{depName}}",
      "semanticCommitType": "fix",
      "semanticCommitScope": "images"
    },
    {
      "description": "An image bump is a chart change, so the chart version must move too: chart-releaser only publishes new versions and ct checks the increment.",
      "matchManagers": [
        "helm-values",
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/**"
      ],
      "bumpVersions": [
        {
          "name": "chart version",
          "filePatterns": [
            "{{packageFileDir}}/Chart.yaml"
          ],
          "matchStrings": [
            "(?m)^version:\\s+(?<version>[^\\s]+)"
          ],
          "bumpType": "patch"
        },
        {
          "name": "umbrella version",
          "filePatterns": [
            "charts/arr-stack/Chart.yaml"
          ],
          "matchStrings": [
            "(?m)^version:\\s+(?<version>[^\\s]+)"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "description": "Automerge routine updates once CI is green. Grouped: every image bump also touches charts/arr-stack/Chart.yaml, so separate PRs conflict.",
      "matchManagers": [
        "helm-values",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "groupName": "chart images"
    },
    {
      "description": "Majors change behaviour and often need a values migration. Review by hand.",
      "matchManagers": [
        "helm-values",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-review-required"
      ]
    },
    {
      "description": "Backstop for images with plain semver tags. The shape rules below override this for the images that need it.",
      "matchManagers": [
        "helm-values",
        "custom.regex"
      ],
      "allowedVersions": "!/(alpha|beta|rc|nightly|develop|testing|unstable|preview)/i"
    },
    {
      "description": "LinuxServer also publishes arch-prefixed (amd64-, arm64v8-) and channel-prefixed (nightly-, preview-, develop-) tags. Loose versioning reads numbers out of those prefixes and invents releases like v438 or v5, so only the release shape is allowed.",
      "matchPackageNames": [
        "/^lscr\\.io\\/linuxserver\\//"
      ],
      "versioning": "loose",
      "allowedVersions": "/^v?\\d+(\\.\\d+){2,3}-ls\\d+$/"
    },
    {
      "description": "Plex tags are a four-part version plus a build hash.",
      "matchPackageNames": [
        "docker.io/plexinc/pms-docker"
      ],
      "versioning": "loose",
      "allowedVersions": "/^\\d+(\\.\\d+){3}-[0-9a-f]+$/"
    },
    {
      "description": "Emby uses four-part versions, which are not semver.",
      "matchPackageNames": [
        "docker.io/emby/embyserver"
      ],
      "versioning": "loose",
      "allowedVersions": "/^\\d+(\\.\\d+){3}$/"
    },
    {
      "description": "qBittorrent tags are version plus image revision. This shape also excludes the lt2 variant, which upstream documents as having memory problems.",
      "matchPackageNames": [
        "docker.io/qbittorrentofficial/qbittorrent-nox"
      ],
      "versioning": "loose",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+-\\d+$/"
    },
    {
      "description": "The Samba image encodes Alpine and Samba versions in the tag.",
      "matchPackageNames": [
        "ghcr.io/servercontainers/samba"
      ],
      "versioning": "loose",
      "allowedVersions": "/^smbd-only-a[\\d.]+-s[\\d.]+-r\\d+$/"
    },
    {
      "description": "Pipeline-only updates, so automerge. Grouped: these pins all live in ci.yaml and would otherwise conflict.",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "automerge": true,
      "automergeType": "pr",
      "matchFileNames": [
        ".github/**"
      ],
      "groupName": "ci toolchain"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "automerge": true
  }
}
